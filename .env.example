TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_CHAT_ID=
API_TOKEN=
APP_PASSWORD=
SESSION_SECRET=

# APP_PASSWORD: usada na migração inicial para criar o hash do usuário admin.
# Após migrar, alterar a senha do admin exige atualizar o banco diretamente.

# Telegram por usuário (cada usuário conecta o próprio Telegram):
#   TELEGRAM_BOT_TOKEN     token do bot, obtido no @BotFather
#   TELEGRAM_BOT_USERNAME  username do bot (sem @), usado no link https://t.me/<bot>?start=<token>
#   TELEGRAM_WEBHOOK_SECRET segredo grande e aleatório; faz parte da URL do webhook
#   TELEGRAM_CHAT_ID       legado/global — NÃO é mais usado pelo monitor por usuário
#
# Configurar o webhook após subir a API (HTTPS público obrigatório):
#   curl "https://api.telegram.org/bot$TELEGRAM_BOT_TOKEN/setWebhook?url=https://SEU_DOMINIO/api/telegram/webhook/$TELEGRAM_WEBHOOK_SECRET"
# Consultar:  curl "https://api.telegram.org/bot$TELEGRAM_BOT_TOKEN/getWebhookInfo"
# Remover:    curl "https://api.telegram.org/bot$TELEGRAM_BOT_TOKEN/deleteWebhook"

# Opcional: origens CORS separadas por vírgula (padrão: só produção ou só localhost em dev)
# CORS_ORIGINS=https://tracker.leogouveia.com

# Mobile nativo: não usa CORS. Autentique com sessão (login) ou API_TOKEN:
#   POST /api/auth/login  { "login": "...", "password": "...", "client": "mobile" }
#   Header: Authorization: Bearer <token>  (ou x-session-token)
# WebView Capacitor/Ionic: capacitor:// e https://localhost já permitidos no CORS.
